{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Postico",
  "version": "0.1.1",
  "identifier": "dev.mypostico.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "My Postico",
      "width": 1440,
      "height": 900,
      "minWidth": 760,
      "minHeight": 480,
      "resizable": true,
      "maximizable": true,
      "minimizable": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
